{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG user feedback record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "user_id",
    "session_id",
    "query",
    "retrieved_docs",
    "answer",
    "answer_issue",
    "missing_facts",
    "source_refs",
    "source_ref_resolvable",
    "permission_scope_issue",
    "followup_decision"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 timestamp for the feedback."
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_docs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_id", "source_file"],
        "properties": {
          "doc_id": {"type": "string"},
          "source_file": {"type": "string"},
          "kb_id": {"type": "string"},
          "rank": {"type": "integer", "minimum": 1}
        }
      }
    },
    "answer": {
      "type": "string"
    },
    "answer_issue": {
      "type": "string",
      "enum": [
        "none",
        "answer_incomplete",
        "answer_wrong",
        "source_ref_unresolvable",
        "permission_scope_issue",
        "retrieval_no_hit",
        "retrieval_wrong_doc",
        "expression_gap",
        "other"
      ]
    },
    "missing_facts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_id", "chunk_id"],
        "properties": {
          "kb_id": {"type": "string"},
          "doc_id": {"type": "string"},
          "chunk_id": {"type": "string"},
          "source_file": {"type": "string"},
          "page_start": {"type": ["integer", "null"]},
          "page_end": {"type": ["integer", "null"]},
          "heading_path": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "source_ref_resolvable": {
      "type": "boolean"
    },
    "permission_scope_issue": {
      "type": "boolean"
    },
    "followup_decision": {
      "type": "string",
      "enum": [
        "no_action",
        "queue_for_review",
        "reproduce",
        "open_answer_revisit",
        "open_retrieval_triage",
        "open_security_bug"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
