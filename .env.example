# Application
APP_NAME=RagWithAIOps
DEBUG=false
HOST=0.0.0.0
PORT=9900

# DashScope / Qwen (required for live LLM and embedding calls)
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG defaults
RAG_TOP_K=3
RAG_DEFAULT_RETRIEVAL_MODE=dense_only
RAG_QUERY_REWRITE_MODE=off
RERANK_ENABLED=false

# Document ingestion
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100
MINERU_CLI_PATH=mineru
MINERU_POSTPROCESS_SCRIPT_PATH=
MINERU_MPLCONFIGDIR=/tmp/mpl

# Redis / RQ
DOCUMENT_PROCESSING_REDIS_URL=redis://localhost:6379/0
DOCUMENT_PROCESSING_QUEUE_NAME=document_processing

# MCP example services
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# Enterprise auth: replace in every deployed environment
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
